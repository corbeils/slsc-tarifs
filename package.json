{
  "name": "slsc-tarifs",
  "version": "1.0.0",
  "private": true,
  "description": "Simulateur de tarifs douaniers CA ⇄ US auto-hébergé",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts && tsc -p server/tsconfig.json",
    "start": "node server/dist/index.js",
    "cli": "tsx server/src/cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.3.3",
    "fflate": "^0.8.3",
    "i18n-iso-countries": "^7.14.0",
    "node-cron": "^3.0.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
