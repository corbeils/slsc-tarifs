# Jeton d'accès à la page Admin (obligatoire pour importer / modifier les règles)
ADMIN_TOKEN=changez-moi-par-une-longue-chaine-aleatoire

# Planification (cron, heure de TZ). Vide = désactivé.
CRON_US=30 3 * * 1          # import HTSUS complet chaque lundi 3 h 30
CRON_FX=15 17 * * 1-5       # taux USD/CAD Banque du Canada, jours ouvrables 17 h 15
# Import automatique du tarif canadien si l'ASFC publie une URL stable (XLSX/CSV)
CA_TARIFF_URL=
CRON_CA=0 4 * * 1

TZ=America/Toronto
LOG_LEVEL=info
